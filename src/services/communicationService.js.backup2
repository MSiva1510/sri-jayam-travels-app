// ── Enhanced Communication Functions for DAY 37 ────────────────────────
// Queue Management ──────────────────────────────────────────
/**
 * Enqueue a communication for later delivery
 * @param {Object} request - Communication request
 * @returns {Promise<Object>} Queue item with ID
 */
export async function enqueueCommunication(request) {
  // Add to queue manager directly for immediate processing
  const queueId = await queueManager.enqueue({
    channel: request.channels?.[0] || CHANNELS.IN_APP,
    payload: {
      to: `${request.recipient?.type}:${request.recipient?.id}`,
      message: request.body,
      subject: request.subject,
      ...request.metadata
    },
    priority: request.priority || 'medium',
    scheduledAt: request.scheduledAt,
    logId: null // Will be set by queue manager if needed
  })
  
  // Return the queue item
  const queueItem = await communicationQueueRepository.getById(queueId)
  return queueItem
}

/**
 * Get queue statistics
 * @returns {Promise<Object>} Queue stats
 */
export async function getQueueStats() {
  return communicationQueueRepository.getStats()
}

/**
 * Get pending queue items
 * @returns {Promise<Array>} Pending queue items
 */
export async function getPendingQueue() {
  return communicationQueueRepository.getPending()
}

/**
 * Retry a failed queue item
 * @param {string} queueId - Queue item ID
 * @returns {Promise<Object>} Updated queue item
 */
export async function retryQueueItem(queueId) {
  const result = await communicationQueueRepository.retry(queueId)
 */
export async function cancelQueueItem(queueId) {
  await communicationQueueRepository.cancel(queueId)
  return true
}

/**
 * Get a specific queue item by ID
 * @param {string} queueId - Queue item ID
 * @returns {Promise<Object|null>} Queue item or null if not found
 */
export async function getQueueItem(queueId) {
  return communicationQueueRepository.getById(queueId)
}

