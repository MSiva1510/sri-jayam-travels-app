// ── Message Templates Helper ─────────────────────────────────────────
/s variable template placeholder variables
 * @param {string} template - Template string with {{var
 * @param {Object} values - Key-value pairs for substitution
 * @returns {string} Rendered template
 */
export function renderTemplate(template, values) {
  return template.replace(/\{\{(\w+)\}\}/g, (match, key) => {
    return values[key] !== undefined ? values[key] : match
  })
}

// ── Communication Health Check ───────────────────────────────
/**
 * Check the health of the communication system
 * @returns {Promise<Object>} Health status
 */
export async function checkCommunicationHealth() {
  try {
    // Check service availability
    const engineStats = getEngineStats()
    const queueStats = await getQueueStats()
    
    // Determine overall health
    const isHealthy = 
      engineStats.engine.sent >= 0 && // Basic check that engine is working
      queueStats.total >= 0           // Queue is accessible
    
    return {
      healthy: isHealthy,
      timestamp: new Date().toISOString(),
      components: {
        engine: { healthy: true, stats: engineStats },
        queue: { healthy: true, stats: queueStats },
        adapters: engineStats.adapters
      }
    }
  } catch (error) {
    return {
      healthy: false,
      error: error.message,
      timestamp: new Date().toISOString()
    }
  }
}
