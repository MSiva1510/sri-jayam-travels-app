# Copy to .env.local and fill in your values (never commit .env.local)
VITE_DATABASE_PROVIDER=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>
VITE_DATABASE_DEBUG=false
VITE_GPS_MOCK=false
# Netlify function (gps-proxy) — optional, falls back to the VITE_ values above
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# GPS_PROXY_ALLOWED_HOSTS=mvt.apmkingstrack.com
# Netlify function (whatsapp-webhook) — server-only, set in Netlify, never VITE_
# WHATSAPP_VERIFY_TOKEN=<any long random string; same value goes in Meta>
# WHATSAPP_APP_SECRET=<Meta App → App settings → Basic → App secret>
# SUPABASE_SERVICE_ROLE_KEY=<Supabase → Project settings → API keys → service_role / secret>
