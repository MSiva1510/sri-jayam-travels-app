# Copy to .env.local and fill in your values (never commit .env.local)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>
VITE_GPS_MOCK=false
# Vercel function (gps-proxy) — optional, falls back to the VITE_ values above
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# GPS_PROXY_ALLOWED_HOSTS=mvt.apmkingstrack.com
# Vercel function (whatsapp-webhook) — server-only, set in Vercel, never VITE_
# WHATSAPP_VERIFY_TOKEN=<any long random string; same value goes in Meta>
# WHATSAPP_APP_SECRET=<Meta App → App settings → Basic → App secret>
# SUPABASE_SERVICE_ROLE_KEY=<Supabase → Project settings → API keys → service_role / secret>
# WhatsApp sending (bot replies, inbox, trip messages) — server-only too
# WHATSAPP_TOKEN=<Meta Business settings → System users → permanent token with whatsapp_business_messaging + whatsapp_business_management>
# WHATSAPP_PHONE_NUMBER_ID=<WhatsApp → API Setup → Phone number ID of the sending number>
# WHATSAPP_NOTIFY_SECRET=<random string; same value as Supabase Vault secret whatsapp_notify_secret>
# WHATSAPP_GRAPH_VERSION=v21.0
# Document OCR (serverless /api/ocr/extract → OpenAI Vision). Provider key is
# server-only (Vercel). VITE_OCR_PROVIDER switches the frontend into the
# backend scan flow; set it before the Vite build so it gets inlined.
# VITE_OCR_PROVIDER=openai
# OPENAI_API_KEY=<OpenAI → API keys → secret key (server-only)>
# OPENAI_OCR_MODEL=<optional, default gpt-4o-mini>
# Supabase Edge Function send-push (set with `supabase secrets set`, not Vercel):
# FCM_SERVICE_ACCOUNT=<Firebase service-account JSON>
# PUSH_FUNCTION_SECRET=<optional long random string for trusted server callers>
# PUSH_ALLOWED_ORIGINS=https://app.travelsjayam.in,http://localhost:5173
