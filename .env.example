# Copy to .env.local and fill in your values (never commit .env.local)
VITE_DATABASE_PROVIDER=supabase
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>
VITE_DATABASE_DEBUG=false
VITE_GPS_MOCK=false
# Netlify function (gps-proxy) — optional, falls back to the VITE_ values above
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# GPS_PROXY_ALLOWED_HOSTS=mvt.apmkingstrack.com
